<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: Slack 👀 번역 데몬 — keeps slack-eyes-daemon.mjs running 24/7.
  Socket Mode WebSocket listener: when the user reacts :eyes: to a Slack message,
  the daemon translates it to Korean and appends to
  ~/.condition-manager/slack-translate/items.jsonl (dashboard renders it).

  Install:
    cp Sources/Slack/Daemon/com.condition-manager.slack-eyes.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.condition-manager.slack-eyes.plist

  Stop / uninstall:
    launchctl unload ~/Library/LaunchAgents/com.condition-manager.slack-eyes.plist
    rm ~/Library/LaunchAgents/com.condition-manager.slack-eyes.plist

  Toggle OFF without unloading (cron-page pattern):
    touch ~/.condition-manager/slack-translate-disabled   # daemon idles
    rm    ~/.condition-manager/slack-translate-disabled   # daemon reconnects

  REQUIRES keychain items cm-slack-app-token (xapp-) and cm-slack-user-token
  (xoxp-). Without them the daemon exits 78 and launchd throttles restarts.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.condition-manager.slack-eyes</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lioncho/.local/bin/node</string>
        <string>/Users/lioncho/Work/departtment_service/projects/condition-manager/Sources/Slack/Daemon/slack-eyes-daemon.mjs</string>
    </array>

    <!-- Long-running daemon: start at load, restart if it dies. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/lioncho/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/cm-slack-eyes.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cm-slack-eyes.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
