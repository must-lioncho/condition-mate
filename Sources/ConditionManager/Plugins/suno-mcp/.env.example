# =========================================================================
# Suno auth — a real generate request uses Bearer + browser-token + device-id.
# browser-token is generated by the server code; you supply the other two.
# =========================================================================

# --- Bearer token (choose ONE) ---
# A) Manual: paste the `authorization: Bearer ...` value (without "Bearer ").
#    Simplest, but expires ~1h — re-paste when calls start 401-ing.
SUNO_AUTH_TOKEN="eyJ..."
# B) Auto-refresh: instead of A, provide the clerk.suno.com cookie and the
#    server mints a fresh Bearer each hour. Leave SUNO_AUTH_TOKEN empty to use this.
# SUNO_COOKIE="__client=...; ..."

# --- Stable device id (from the `device-id` request header) ---
SUNO_DEVICE_ID="00000000-0000-0000-0000-000000000000"

# --- Optional: your plan id (metadata.user_tier from the request payload) ---
# SUNO_USER_TIER="3eaebef3-..."

# --- Endpoints / model (verify against your own capture) ---
SUNO_BASE_URL="https://studio-api-prod.suno.com"
SUNO_MODEL="chirp-fenix"
# CLERK_BASE_URL="https://clerk.suno.com"      # only for auto-refresh (option B)
# CLERK_JS_VERSION="5.35.0"

# --- Downloads ---
DOWNLOAD_DIR="./downloads"
