# --- Suno auth ---
# Logged-in Suno session cookie, copied from your browser (DevTools > Application > Cookies,
# or the "Cookie:" request header from any studio-api / clerk request in the Network tab).
# Keep the WHOLE cookie string. This is the only secret the server needs.
SUNO_COOKIE="__client=...; __client_uat=...; ..."

# --- Endpoints (VERIFY against your own Network capture; Suno changes these) ---
# Clerk auth host used by Suno.
CLERK_BASE_URL="https://clerk.suno.com"
# Clerk JS version string sent as a query param on Clerk requests.
CLERK_JS_VERSION="5.35.0"
# Suno studio API host.
SUNO_BASE_URL="https://studio-api.suno.ai"

# --- Generation defaults ---
# Model version tag sent as "mv" (e.g. chirp-v3-5, chirp-v4). Confirm current value in Network tab.
SUNO_MODEL="chirp-v3-5"

# Where get_audio downloads files to (absolute path recommended).
DOWNLOAD_DIR="./downloads"
