<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ConditionMate</string>
    <key>CFBundleDisplayName</key>
    <string>Condition Mate</string>
    <key>CFBundleIdentifier</key>
    <string>com.lioncho.conditionmate</string>
    <key>CFBundleExecutable</key>
    <string>ConditionMate</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- App icon shown in the Dock and app switcher (Contents/Resources/AppIcon.icns). -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- Regular app: Dock icon + app switcher presence, plus the menu bar status item.
         (Previously LSUIElement=true made it menu-bar-only with no Dock icon.) -->
    <key>LSUIElement</key>
    <false/>
    <!-- Reading the active browser tab's URL (per-site activity) uses Apple Events. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>활성 브라우저 탭의 사이트를 읽어 활동 종류(리서치/시청)를 구분합니다.</string>
    <!-- The BGM window's WKWebView loads the app's own loopback server over http (127.0.0.1).
         Allow local networking so ATS does not block it. Only loopback is permitted. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
